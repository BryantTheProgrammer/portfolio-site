---
import { projects } from "../data/projects.js";
---

<div class="grid projects-grid projects-grid--featured">
  {projects.map((project) => (
    <a class="card project-card project-card--curated" href={`/projects/${project.slug}`}>
      <img class="project-card__image" src={project.image} alt={project.alt} />
      <h3>{project.title}</h3>
      <p class="project-card__tagline">{project.tagline}</p>
      <div class="project-card__chips" aria-label={`${project.title} metrics`}>
        {project.metrics.map((metric) => <span>{metric}</span>)}
      </div>
      <div class="project-card__chips project-card__chips--tech" aria-label={`${project.title} technologies`}>
        {project.tech.map((technology) => <span>{technology}</span>)}
      </div>
    </a>
  ))}
</div>
