---
const projects = [
  { slug: "laser-etcher", image: "/images/test-image.jpg", alt: "Laser Etcher Modernization project", title: "Laser Etcher Modernization", tagline: "Restored serialized traceability with a production-ready Ignition application.", metrics: ["$143K+ savings", "11 lines / 5 plants", "5,000 records/batch"], tech: ["Ignition", "Python/Jython", "SQL"] },
  { slug: "suds", image: "/images/test-image.jpg", alt: "SUDS Soap Usage and Dispensing System project", title: "SUDS — Soap Usage & Dispensing System", tagline: "Four-tank water quality monitoring with automated dosing at a fraction of vendor cost.", metrics: ["$3,051 delivered", "$35,850 quote", "91% reduction"], tech: ["RevPi", "Python", "Ignition Perspective"] },
  { slug: "plant-floor-visibility", image: "/images/test-image.jpg", alt: "Plant Floor Visibility Platform project", title: "Plant Floor Visibility Platform", tagline: "Real-time operational visibility presented to the North America plant manager network.", metrics: ["NA best practice", "Live visibility", "Plant-wide KPIs"], tech: ["Ignition Perspective", "OPC UA", "L2L"] },
  { slug: "mes-revpi-integration", image: "/images/test-image.jpg", alt: "MES API and IIoT Integration project", title: "MES, API & IIoT Integration", tagline: "L2L and RevPi standardization that turned repeatable integration into a two-hour playbook.", metrics: ["~2 hr deployment", "Reusable images", "31+ plants"], tech: ["L2L REST API", "Node-RED", "RevPi"] },
];
---

<div class="grid projects-grid projects-grid--featured">
  {projects.map((project) => (
    <a class="card project-card project-card--curated" href={`/projects/${project.slug}`}>
      <img class="project-card__image" src={project.image} alt={project.alt} />
      <h3>{project.title}</h3>
      <p class="project-card__tagline">{project.tagline}</p>
      <div class="project-card__chips" aria-label={`${project.title} metrics`}>
        {project.metrics.map((metric) => <span>{metric}</span>)}
      </div>
      <div class="project-card__chips project-card__chips--tech" aria-label={`${project.title} technologies`}>
        {project.tech.map((technology) => <span>{technology}</span>)}
      </div>
    </a>
  ))}
</div>
