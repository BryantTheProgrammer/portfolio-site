---
const { active = "portfolio", demo = false, landing = false } = Astro.props;
---

<header class:list={["site-header", { "site-header--demo": demo, "site-header--landing": landing }]}>
  <div class="container nav">
    <a class="brand" href="/">
      <img src="/favicon.svg" alt="" />
      <span>Bryant Hayden</span>
    </a>
    <nav class="nav__links" aria-label="Main navigation">
      <a class:list={["nav__link", { "is-active": active === "portfolio" }]} href="/" aria-current={active === "portfolio" ? "page" : undefined}>Portfolio</a>
      <a class:list={["nav__link", "nav__link--contact", { "is-active": active === "contact" }]} href="/contact" aria-current={active === "contact" ? "page" : undefined}>Contact</a>
    </nav>
  </div>
</header>
