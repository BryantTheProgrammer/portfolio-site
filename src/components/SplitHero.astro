<section class="split-hero" id="experience" aria-label="Personal and professional showcases">
  <a class="split-hero__link split-hero__link--personal" href="/personal" aria-label="Explore the Builder and Teacher page">
    <span class="split-hero__copy">
      <span class="eyebrow">PERSONAL</span>
      <span class="split-hero__headline">builder</span>
      <span class="split-hero__description">
        Explore the teaching, robotics, academic, and personal experiences that shaped how I build and communicate.
      </span>
    </span>
  </a>

  <a class="split-hero__link split-hero__link--professional" href="/journey" aria-label="Explore the Professional Showcase">
    <span class="split-hero__copy">
      <span class="eyebrow">PROFESSIONAL</span>
      <span class="split-hero__headline">&lt;systems&gt;</span>
      <span class="split-hero__description">
        Follow the technical progression from computer science to SCADA ownership, automation, and multi-plant impact.
      </span>
    </span>
  </a>

  <div class="split-hero__portrait">
    <img
      class="split-hero__image split-hero__image--professional"
      src="/img/bryant-pro.png"
      alt=""
      width="1024"
      height="1024"
    />
    <img
      class="split-hero__image split-hero__image--personal"
      src="/img/bryant-personal.png"
      alt=""
      width="1024"
      height="1024"
    />
    <a
      class="split-hero__mobile-art-link"
      href="/journey"
      aria-label="Explore the Professional Showcase"
    ></a>
  </div>

  <nav class="split-hero__mobile-nav" aria-label="Portfolio introduction">
    <p class="split-hero__mobile-copy">Swipe through my work and the interests that shape it.</p>
    <a class="split-hero__mobile-action" href="/journey" aria-live="polite" hidden>Explore the professional showcase</a>
  </nav>
</section>

<script>
  const splitHero = document.querySelector(".split-hero");

  if (splitHero instanceof HTMLElement) {
    const desktopHover = window.matchMedia("(hover: hover) and (min-width: 761px)");
    const mobileInteraction = window.matchMedia("(max-width: 760px), (hover: none)");
    const mobileArtLink = splitHero.querySelector(".split-hero__mobile-art-link");
    const mobileAction = splitHero.querySelector(".split-hero__mobile-action");
    let pointerStartX = 0;
    let isDragging = false;
    let hasDragged = false;
    let suppressNextClick = false;
    let selectedDestination: string | null = "/journey";
    let pendingDestination = "/journey";

    const setMobileSelection = (position: number) => {
      const personalSelected = position < 0.5;
      pendingDestination = personalSelected ? "/personal" : "/journey";

      splitHero.style.setProperty("--x", `${position * 100}%`);
      splitHero.dataset.active = personalSelected ? "personal" : "professional";
    };

    const commitMobileSelection = () => {
      selectedDestination = pendingDestination;
      const personalSelected = selectedDestination === "/personal";
      if (mobileAction instanceof HTMLAnchorElement) {
        mobileAction.href = selectedDestination;
        mobileAction.textContent = personalSelected ? "Explore the personal page" : "Explore the professional showcase";
        mobileAction.hidden = false;
      }

      if (mobileArtLink instanceof HTMLAnchorElement) {
        mobileArtLink.href = selectedDestination;
        mobileArtLink.setAttribute(
          "aria-label",
          personalSelected ? "Open the personal page" : "Open the professional showcase",
        );
      }

      splitHero.style.setProperty("--x", "50%");
      delete splitHero.dataset.active;
    };

    splitHero.addEventListener("pointermove", (event) => {
      if (mobileInteraction.matches && isDragging) {
        const bounds = splitHero.getBoundingClientRect();
        const position = Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width));

        if (Math.abs(event.clientX - pointerStartX) > 8) {
          hasDragged = true;
        }

        setMobileSelection(position);
        return;
      }

      if (!desktopHover.matches || event.pointerType !== "mouse") return;

      const bounds = splitHero.getBoundingClientRect();
      const position = Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width));
      const personalReveal = Math.max(0, Math.min(1, (0.8 - position) / 0.6));

      splitHero.style.setProperty("--x", `${personalReveal * 100}%`);

      if (personalReveal >= 0.999) {
        splitHero.dataset.active = "personal";
      } else if (personalReveal <= 0.001) {
        splitHero.dataset.active = "professional";
      } else {
        delete splitHero.dataset.active;
      }
    });

    splitHero.addEventListener("pointerdown", (event) => {
      if (
        !mobileInteraction.matches ||
        event.button !== 0 ||
        !(event.target instanceof Element) ||
        !event.target.closest(".split-hero__portrait")
      ) {
        return;
      }

      isDragging = true;
      hasDragged = false;
      pointerStartX = event.clientX;
      event.preventDefault();
      splitHero.classList.add("is-dragging");
      splitHero.setPointerCapture(event.pointerId);
    });

    splitHero.addEventListener("pointerup", () => {
      const wasDragging = isDragging;
      isDragging = false;
      splitHero.classList.remove("is-dragging");

      if (!wasDragging) return;

      if (hasDragged) {
        commitMobileSelection();
        hasDragged = false;
        suppressNextClick = true;
        window.setTimeout(() => {
          suppressNextClick = false;
        }, 0);
      } else if (mobileArtLink instanceof HTMLAnchorElement) {
        if (selectedDestination) mobileArtLink.click();
      }
    });

    splitHero.addEventListener("pointercancel", () => {
      splitHero.classList.remove("is-dragging");
      if (hasDragged) {
        commitMobileSelection();
      } else {
        splitHero.style.setProperty("--x", "50%");
        delete splitHero.dataset.active;
      }

      isDragging = false;
      hasDragged = false;
    });

    splitHero.addEventListener("click", (event) => {
      if (mobileInteraction.matches && (suppressNextClick || !selectedDestination || isDragging || hasDragged)) {
        event.preventDefault();
        suppressNextClick = false;
      }
    });

    splitHero.addEventListener("pointerleave", () => {
      if (mobileInteraction.matches) return;

      splitHero.style.removeProperty("--x");
      delete splitHero.dataset.active;
    });
  }
</script>
