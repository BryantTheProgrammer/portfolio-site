---
const certifications = [
  {
    id: "ignition-core",
    title: "Ignition 8.1 Certified",
    issuer: "Inductive Automation",
    year: "2026",
    date: "March 10, 2026",
    mark: "IC",
    category: "Industrial software",
    summary: "Validated foundation in Ignition platform development, configuration, and support.",
    details: "A focused credential for building reliable Ignition systems across visualization, data, security, alarming, and operational workflows.",
    assetPath: "/certifications/ignition-8-1-certified.pdf",
    assetType: "pdf",
  },
  {
    id: "ignition-university",
    title: "Ignition University Credential",
    issuer: "Inductive Automation",
    year: "2025",
    mark: "IU",
    category: "SCADA / HMI",
    summary: "Formal training in the Ignition ecosystem and plant-floor application patterns.",
    details: "This credential supports practical work across Perspective, gateway configuration, tags, scripting, and production-oriented SCADA design.",
    assetPath: "",
    assetType: "",
  },
  {
    id: "responsive-web-design",
    title: "Responsive Web Design",
    issuer: "freeCodeCamp",
    year: "2024",
    mark: "RW",
    category: "Web development",
    summary: "Demonstrated fluency in accessible, responsive HTML and CSS layouts.",
    details: "A web foundation covering semantic HTML, responsive layouts, accessibility, visual hierarchy, and modern CSS techniques.",
    assetPath: "",
    assetType: "",
  },
  {
    id: "git-essentials",
    title: "Git Essentials",
    issuer: "LinkedIn Learning",
    year: "2024",
    mark: "G",
    category: "Engineering practice",
    summary: "Version-control fundamentals for collaborative software delivery.",
    details: "Covers practical Git workflows, branching, commits, collaboration, and repository hygiene for maintainable project history.",
    assetPath: "",
    assetType: "",
  },
  {
    id: "c-sharp",
    title: "C# Certification",
    issuer: "Microsoft / freeCodeCamp",
    year: "2024",
    mark: "C#",
    category: "Programming",
    summary: "A formal programming credential covering core C# concepts and application development.",
    details: "A programming foundation in C# syntax, object-oriented design, data structures, and application development patterns.",
    assetPath: "",
    assetType: "",
  },
];

const { featured = false } = Astro.props;
const visibleCertifications = featured ? certifications.slice(0, 3) : certifications;
---

<div class="certification-grid">
  {visibleCertifications.map((certification) => (
    <article class="certification-card">
      <div class="certification-card__inner">
        <div class="certification-card__face certification-card__face--front">
          <button
            class="certification-card__flip"
            type="button"
            aria-expanded="false"
            aria-label={`Show details for ${certification.title}`}
          >
            <span class="certification-card__topline">
              <span class="certification-card__mark">{certification.mark}</span>
              <span class="certification-card__year">{certification.year}</span>
            </span>
            <span class="certification-card__category">{certification.category}</span>
            <strong>{certification.title}</strong>
            <span class="certification-card__issuer">{certification.issuer}</span>
            <span class="certification-card__open">View credential <span aria-hidden="true">↻</span></span>
          </button>
        </div>
        <div class="certification-card__face certification-card__face--back" aria-hidden="true" inert>
          <div class="certification-card__back-content">
            <button
              class="certification-card__return"
              type="button"
              aria-expanded="false"
              aria-label={`Return to ${certification.title} summary`}
              tabindex="-1"
            >← Back</button>
            <p class="certification-card__category">{certification.category}</p>
            <strong class="certification-card__back-title">{certification.title}</strong>
            <p class="certification-card__back-meta">{certification.issuer} · {certification.date ?? certification.year}</p>
            <p class="certification-card__back-summary">{certification.summary}</p>
            <p class="certification-card__back-detail">{certification.details}</p>
            {certification.assetType === "pdf" && certification.assetPath ? (
              <>
                <iframe
                  class="certification-card__preview"
                  src={`${certification.assetPath}#toolbar=0&navpanes=0`}
                  title={`${certification.title} PDF preview`}
                  loading="lazy"
                  tabindex="-1"
                ></iframe>
                <a class="certification-card__pdf-link" href={certification.assetPath} target="_blank" rel="noreferrer">
                  Open PDF in a new tab <span aria-hidden="true">↗</span>
                </a>
              </>
            ) : (
              <p class="certification-card__pending">A document preview is not available for this credential.</p>
            )}
          </div>
        </div>
      </div>
    </article>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>(".certification-card").forEach((card) => {
    const flipButton = card.querySelector<HTMLButtonElement>(".certification-card__flip");
    const returnButton = card.querySelector<HTMLButtonElement>(".certification-card__return");
    const front = card.querySelector<HTMLElement>(".certification-card__face--front");
    const back = card.querySelector<HTMLElement>(".certification-card__face--back");

    if (!flipButton || !returnButton || !front || !back) {
      throw new Error("A certification card is missing its flip controls or faces.");
    }

    const setFlipped = (flipped: boolean, restoreFocus = true) => {
      card.classList.toggle("is-flipped", flipped);
      flipButton.setAttribute("aria-expanded", String(flipped));
      returnButton.setAttribute("aria-expanded", String(flipped));
      front.setAttribute("aria-hidden", String(flipped));
      back.setAttribute("aria-hidden", String(!flipped));
      front.toggleAttribute("inert", flipped);
      back.toggleAttribute("inert", !flipped);
      flipButton.tabIndex = flipped ? -1 : 0;
      returnButton.tabIndex = flipped ? 0 : -1;
      if (restoreFocus) (flipped ? returnButton : flipButton).focus();
    };

    flipButton.addEventListener("click", () => setFlipped(true));
    returnButton.addEventListener("click", () => setFlipped(false));
    card.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && card.classList.contains("is-flipped")) {
        setFlipped(false);
      }
    });
  });
</script>
