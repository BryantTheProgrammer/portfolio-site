---
import SiteNav from "../components/SiteNav.astro";
import BackToTop from "../components/BackToTop.astro";
import CertificationGrid from "../components/CertificationGrid.astro";
import SplitHero from "../components/SplitHero.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Bryant Hayden is an IT/OT professional focused on SCADA, MES, IIoT, and manufacturing automation."
    />
    <title>Bryant Hayden | Controls Engineer, SCADA &amp; MES</title>
    <meta property="og:title" content="Bryant Hayden | Controls Engineer, SCADA &amp; MES" />
    <meta property="og:description" content="Industrial automation, SCADA, MES, and production systems portfolio." />
    <meta property="og:image" content="/og-preview.svg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-preview.svg" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteNav active="portfolio" />

    <main>
      <SplitHero />

      <section class="portfolio-intro" id="portfolio-intro">
        <div class="container">
          <div class="portfolio-intro__content">
            <div class="hero__identity" aria-label="Bryant Hayden portfolio">
              <p class="hero__identity-name">Bryant Hayden</p>
              <p class="hero__identity-role">Controls Engineer</p>
            </div>
            <div>
              <h1>Controls engineering for connected plant floors.</h1>
              <p class="lead">
                I build and integrate SCADA, MES, and IIoT systems that connect equipment, operators, and production data.
              </p>
              <div class="cta-row">
                <a class="button button--primary" href="/projects">Explore Projects</a>
                <a class="button button--secondary" href="/contact">Get in Touch</a>
              </div>
            </div>
          </div>
          <div class="portfolio-impact" aria-label="Selected project impact">
            <div class="portfolio-impact__item">
              <strong>9 lines</strong>
              <span>supported by plant SCADA</span>
            </div>
            <div class="portfolio-impact__item">
              <strong>91%</strong>
              <span>SUDS cost reduction</span>
            </div>
            <div class="portfolio-impact__item">
              <strong>~550 hrs</strong>
              <span>recovered each year</span>
            </div>
            <div class="portfolio-impact__item">
              <strong>31+ plants</strong>
              <span>IIoT gateway playbook reach</span>
            </div>
          </div>
        </div>
      </section>

      <section id="expertise" class="section">
        <div class="container">
          <div class="section__header">
            <h2 class="section__title">Core Expertise</h2>
          </div>
          <div class="grid skills-grid">
            <div class="card">
              <h3>Systems &amp; Delivery</h3>
              <ul class="skill-list">
                <li>Ignition SCADA application ownership and development</li>
                <li>Requirements through testing, commissioning, documentation, and operator training</li>
                <li>Production workflows connecting SCADA, MES, and ERP</li>
              </ul>
            </div>

            <div class="card">
              <h3>Integration &amp; Plant Insight</h3>
              <ul class="skill-list">
                <li>PLC, equipment, MES, and ERP data integration</li>
                <li>MQTT, OPC UA, REST APIs, and SQL data flows</li>
                <li>Plant-floor visibility, traceability, and operational KPIs</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section id="certifications" class="section certifications-preview">
        <div class="container">
          <div class="section__header section__header--split">
            <div>
              <p class="eyebrow">Credentials</p>
              <h2 class="section__title">Proof behind the practice.</h2>
            </div>
            <a class="button button--secondary" href="/certifications">View all certifications</a>
          </div>
          <CertificationGrid featured />
        </div>
      </section>

      <section id="contact" class="section contact">
        <div class="container">
          <div class="card contact-card">
            <div>
              <p class="eyebrow">Let’s Connect</p>
              <h2 class="section__title">Open to automation, integration, and analytics opportunities.</h2>
            </div>
            <div class="contact-links">
              <a class="button button--secondary" href="mailto:bryantchayden@gmail.com">Email</a>
              <a class="button button--secondary" href="https://www.linkedin.com/in/bhcs1/" target="_blank" rel="noreferrer">LinkedIn</a>
              <a class="button button--secondary" href="/contact-card">Contact Card</a>
              <a class="button button--secondary" href="/resume">Resume</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <BackToTop />
      <div class="container footer__content">
        <p>© 2026 Bryant Hayden</p>
        <p>IT/OT • SCADA • MES • IIoT</p>
      </div>
    </footer>
    <script src="/script.js" is:inline></script>
  </body>
</html>
