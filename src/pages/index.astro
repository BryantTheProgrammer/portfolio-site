---
import SiteNav from "../components/SiteNav.astro";
import CertificationGrid from "../components/CertificationGrid.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Bryant Hayden is an IT/OT professional focused on SCADA, MES, IIoT, and manufacturing automation."
    />
    <title>Bryant Hayden — SCADA / MES Developer</title>
    <meta property="og:title" content="Bryant Hayden — SCADA / MES Developer" />
    <meta property="og:description" content="Industrial automation, SCADA, MES, and production systems portfolio." />
    <meta property="og:image" content="/og-preview.svg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-preview.svg" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteNav active="portfolio" landing />

    <main id="top">
      <section class="hero">
        <div class="container hero__grid">
          <div class="hero__content">
            <div class="hero__identity" aria-label="Bryant Hayden portfolio">
              <p class="hero__identity-name">Bryant Hayden</p>
              <p class="hero__identity-role">IT/OT / SCADA / Industrial Automation</p>
            </div>
            <p class="eyebrow">SCADA Full-Stack Developer | Industrial Automation</p>
            <h1>Building production software that holds up on the plant floor.</h1>
            <p class="lead">
              I build and support production SCADA, MES, and IIoT applications with Ignition, Python, SQL, and industrial
              integrations, connecting operators, equipment, and business systems with practical digital solutions.
            </p>
            <div class="cta-row">
              <a class="button button--primary" href="/projects">View Projects</a>
              <a class="button button--secondary" href="/contact">Contact Me</a>
            </div>
            <ul class="capability-list" aria-label="Key capabilities">
              <li>SCADA</li>
              <li>MES</li>
              <li>IIoT</li>
              <li>Automation</li>
            </ul>
          </div>

          <aside class="profile-card" aria-label="Professional summary">
            <div class="profile-frame">
              <img
                class="profile-image"
                src="/images/headshot.jpg"
                alt="Headshot of Bryant Hayden"
              />
            </div>
            <div class="stats">
              <div class="stat">
                <strong>Sole developer</strong>
                Owner of a plant SCADA environment
              </div>
              <div class="stat">
                <strong>91%</strong>
                Cost cut vs. vendor quote on SUDS
              </div>
              <div class="stat">
                <strong>550 hrs/yr</strong>
                Manual reporting eliminated
              </div>
              <div class="stat">
                <strong>31+ plants</strong>
                Integration precedent adopted across the North America network
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section id="about" class="section">
        <div class="container">
          <div class="section__header">
            <h2 class="section__title">About</h2>
          </div>
          <div class="card">
            <p>
              I design and support production SCADA and MES systems. I connect operators, equipment, and business data into
              reliable workflows that hold up on the plant floor.
            </p>
          </div>
        </div>
      </section>

      <section id="expertise" class="section">
        <div class="container">
          <div class="section__header">
            <h2 class="section__title">Core Expertise</h2>
          </div>
          <div class="grid skills-grid">
            <div class="card">
              <h3>Systems &amp; Delivery</h3>
              <ul class="skill-list">
                <li>SCADA application ownership</li>
                <li>Production workflow design</li>
                <li>MES and ERP operational integration</li>
              </ul>
            </div>

            <div class="card">
              <h3>Operational Impact</h3>
              <ul class="skill-list">
                <li>Plant-floor visibility and KPI systems</li>
                <li>Traceability and serialization</li>
                <li>Commissioning, documentation, and operator enablement</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section id="projects" class="section">
        <div class="container">
          <div class="section__header">
            <h2 class="section__title">Featured Projects</h2>
          </div>
          <ProjectGrid />
        </div>
      </section>

      <section class="section work-method" aria-labelledby="work-method-title">
        <div class="container">
          <div class="section__header">
            <p class="eyebrow">How I work</p>
            <h2 id="work-method-title" class="section__title">From requirement to confident adoption.</h2>
          </div>
          <div class="work-method__strip">
            <div class="work-step"><span class="work-step__icon" aria-hidden="true">01</span><strong>Requirements</strong></div>
            <span class="work-step__connector" aria-hidden="true"></span>
            <div class="work-step"><span class="work-step__icon" aria-hidden="true">02</span><strong>Dev Gateway</strong></div>
            <span class="work-step__connector" aria-hidden="true"></span>
            <div class="work-step"><span class="work-step__icon" aria-hidden="true">03</span><strong>Commissioning</strong></div>
            <span class="work-step__connector" aria-hidden="true"></span>
            <div class="work-step"><span class="work-step__icon" aria-hidden="true">04</span><strong>Docs</strong></div>
            <span class="work-step__connector" aria-hidden="true"></span>
            <div class="work-step"><span class="work-step__icon" aria-hidden="true">05</span><strong>Training</strong></div>
          </div>
        </div>
      </section>

      <section id="experience" class="section">
        <div class="container">
          <div class="section__header">
            <h2 class="section__title">Choose your view</h2>
          </div>
          <div class="grid experience-grid">
            <article class="card experience-card">
              <p class="eyebrow">Personal</p>
              <h3>The person behind the work</h3>
              <p>
                Explore the teaching, robotics, academic, and personal experiences that shaped how I build and communicate.
              </p>
              <a href="/about">Open Personal Showcase</a>
            </article>

            <article class="card experience-card">
              <p class="eyebrow">Professional</p>
              <h3>The systems and impact</h3>
              <p>
                Follow the technical progression from computer science to SCADA ownership, automation, and multi-plant impact.
              </p>
              <a href="/journey">Open Professional Showcase</a>
            </article>
          </div>
        </div>
      </section>

      <section id="certifications" class="section certifications-preview">
        <div class="container">
          <div class="section__header section__header--split">
            <div>
              <p class="eyebrow">Credentials</p>
              <h2 class="section__title">Proof behind the practice.</h2>
            </div>
            <a class="button button--secondary" href="/certifications">View all certifications</a>
          </div>
          <CertificationGrid featured />
        </div>
      </section>

      <section id="contact" class="section contact">
        <div class="container">
          <div class="card contact-card">
            <div>
              <p class="eyebrow">Let’s Connect</p>
              <h2 class="section__title">Open to automation, integration, and analytics opportunities.</h2>
            </div>
            <div class="contact-links">
              <a class="button button--secondary" href="mailto:bryantchayden@gmail.com">Email</a>
              <button
                class="button button--secondary copy-email"
                type="button"
                data-copy-email="bryantchayden@gmail.com"
                aria-label="Copy email address"
                title="Copy email address"
              >
                <span class="copy-icon" aria-hidden="true"></span>
                <span class="copy-email__label">Copy Email</span>
              </button>
              <a class="button button--secondary" href="https://www.linkedin.com/in/bhcs1/" target="_blank" rel="noreferrer">LinkedIn</a>
              <a class="button button--secondary" href="/resume">Resume</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer__content">
        <p>© 2026 Bryant Hayden</p>
        <p>IT/OT • SCADA • MES • IIoT</p>
      </div>
    </footer>
    <script is:inline>
      const landingHeader = document.querySelector(".site-header--landing");
      const identity = document.querySelector(".hero__identity");

      if (landingHeader && identity) {
        const updateLandingHeader = () => {
          landingHeader.classList.toggle("is-scrolled", identity.getBoundingClientRect().bottom < 72);
        };

        window.addEventListener("scroll", updateLandingHeader, { passive: true });
        updateLandingHeader();
      }
    </script>
    <script src="/script.js" is:inline></script>
  </body>
</html>
