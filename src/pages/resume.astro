import SiteNav from "../components/SiteNav.astro";
import BackToTop from "../components/BackToTop.astro";
import SiteCredit from "../components/SiteCredit.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Resume for Bryant Hayden, SCADA full-stack application developer specializing in industrial automation."
    />
    <title>Bryant Hayden — Controls Engineer</title>
    <meta property="og:title" content="Bryant Hayden — Controls Engineer" />
    <meta property="og:description" content="Industrial automation, SCADA, MES, and production systems portfolio." />
    <meta property="og:image" content="/og-preview.svg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-preview.svg" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="resume-page">
    <SiteNav active="resume" />

    <main class="resume-shell">
      <div class="container">
        <article class="resume-document">
          <header class="resume-header">
            <div>
              <p class="eyebrow">Resume</p>
              <h1>Bryant Hayden</h1>
              <p class="resume-role">Controls Engineer</p>
            </div>
            <div class="resume-contact">
              <a href="mailto:bryantchayden@gmail.com">bryantchayden@gmail.com</a>
              <a href="https://www.linkedin.com/in/bhcs1/" target="_blank" rel="noreferrer">linkedin.com/in/bhcs1</a>
              <span>(971) 716-6117</span>
              <span>Lebanon, OR</span>
            </div>
          </header>

          <section class="resume-section">
            <h2>Summary</h2>
            <p>
              Full-stack application developer with a B.S. in Computer Science and nearly two years building and supporting
              production SCADA, MES, and IIoT applications in a high-volume manufacturing plant. Works the full delivery
              cycle: validating requirements with operations stakeholders, writing specifications, developing in Ignition
              Perspective with Python/Jython and SQL, testing against documented plans on a dedicated development gateway,
              then commissioning, documenting, and training end users. Comfortable sitting between IT and Engineering and
              translating between them. Work developed at Stayton has set the integration precedent adopted across 31+ plants,
              with two production systems poised for rollout to 11 lines across 5 plants.
            </p>
          </section>

          <section class="resume-section">
            <h2>Technical Skills</h2>
            <div class="resume-skill-grid">
              <div>
                <h3>Languages</h3>
                <p>Python, Jython, SQL, JavaScript, Java, C, C++, C#, HTML/CSS</p>
              </div>
              <div>
                <h3>Industrial Software</h3>
                <p>Ignition 8.1 (Perspective, Edge), SCADA, HMI, MES, UDTs, alarming, historian, OEE</p>
              </div>
              <div>
                <h3>Protocols &amp; Integration</h3>
                <p>MQTT, OPC UA, TCP/IP, REST APIs, Node-RED, Allen-Bradley PLCs, ERP to MES data flows, Revolution Pi</p>
              </div>
              <div>
                <h3>Databases</h3>
                <p>SQL Server, MySQL, schema design, query optimization, data pipelines and normalization</p>
              </div>
              <div>
                <h3>Tools &amp; Practice</h3>
                <p>Git/GitHub, Agile and Scrum boards, documented test plans, development vs. production environments, Visual Studio / VS Code, Linux, Windows Server</p>
              </div>
              <div>
                <h3>Other</h3>
                <p>Cisco switching, VLAN segmentation, industrial networking, ISA-95, Industry 4.0</p>
              </div>
            </div>
          </section>

          <section class="resume-section">
            <h2>Professional Experience</h2>
            <div class="resume-entry">
              <div class="resume-entry-heading">
                <div>
                  <h3>IT Lead - Plant Applications &amp; Automation</h3>
                  <p class="resume-company">JELD-WEN | Stayton, OR</p>
                </div>
                <p class="resume-date">Nov 2024 - Present</p>
              </div>
              <ul>
                <li>Sole developer and system owner for the Stayton Ignition SCADA environment, supporting 9 production lines at roughly 2,300 units per day.</li>
                <li>Develop, test, and maintain Ignition 8.1 Perspective applications used daily in manufacturing operations, covering navigation, role-based security, alarming, diagnostic views, and reusable components.</li>
                <li>Validate system requirements with production, maintenance, and CI stakeholders, then write the programming specifications that drive development.</li>
                <li>Write backend logic in Python/Jython and SQL integrating ERP, MES, PLCs, databases, edge gateways, and vendor equipment over MQTT, OPC UA, TCP/IP, and REST APIs.</li>
                <li>Develop and test on a dedicated development gateway separate from production, using documented test plans and version control to validate changes before release.</li>
                <li>Collaborate on a cross-site development team, coordinating with corporate IT, controls engineering, vendors, and plant operations; author runbooks, SOPs, and architecture diagrams so systems can be supported by others.</li>
                <li>Train end users from first-time computer users to senior stakeholders, driving adoption and measurably reducing support escalations.</li>
                <li>Automated reporting with SQL, Python, and VBA, eliminating 12 daily manual reports and a recurring biweekly report to recover roughly 550 labor hours per year.</li>
              </ul>
            </div>
          </section>

          <section class="resume-section">
            <h2>Key Projects</h2>
            <div class="resume-projects">
              <article class="resume-project">
                <h3>SUDS - Soap Usage &amp; Dispensing System (in production, multi-plant rollout planned)</h3>
                <ul>
                  <li>Built an end-to-end water quality monitoring and automated dosing system for the plant's glass washer, owning the stack from sensor to user interface.</li>
                  <li>Delivered the four-tank system for $3,051 against a $35,850 commercial vendor quote, a 91% cost reduction, with Ignition-native trending, alarming, and dosing control included rather than quoted separately.</li>
                  <li>Diagnosed cross-sensor interference in the prototype and specified four industrial isolated conductivity probes and transducers for stable independent per-tank readings, moving the system from proof of concept to production grade.</li>
                  <li>Developed Python edge software and a data normalization layer on a Revolution Pi gateway behind an Ignition Perspective front end for live monitoring, alarming, and remote control.</li>
                </ul>
              </article>
              <article class="resume-project">
                <h3>Ignition Laser Etcher &amp; Serialization System</h3>
                <ul>
                  <li>Developed a full-stack Ignition and Python replacement for a deprecated Java etching platform, restoring serialized traceability and projecting $143K+ savings over three years, architected toward a five-site, 11-line rollout.</li>
                  <li>Built an operator interface handling batches of roughly 5,000 records across 500 pages with responsive navigation, supporting lines etching thousands of lites per day.</li>
                  <li>Gathered requirements with operations and quality, then built across PLC tag integration, Jython scripting, SQL-backed configuration, vendor equipment communications, and ERP-to-MES data flow.</li>
                </ul>
              </article>
              <article class="resume-project">
                <h3>Plant Floor Visibility Platform</h3>
                <ul>
                  <li>Designed a real-time Ignition Perspective floor map and dashboard suite surfacing live equipment status, downtime conditions, alarms, and KPIs in a single interface.</li>
                  <li>Integrated OPC UA endpoints alongside MES data; presented the platform to senior leadership and the North America plant manager network as a designated best practice, driving inbound adoption requests from other sites.</li>
                </ul>
              </article>
              <article class="resume-project">
                <h3>MES (L2L) Implementation &amp; API Integration</h3>
                <ul>
                  <li>Led site rollout of L2L production, downtime, quality, and reporting modules aligned to enterprise standards.</li>
                  <li>Developed against the externally hosted Leading2Lean REST API to move production data programmatically, with data mappings that automated machine data capture and eliminated manual operator entry.</li>
                </ul>
              </article>
              <article class="resume-project">
                <h3>IIoT Edge Gateway Standardization</h3>
                <ul>
                  <li>Standardized Revolution Pi deployments using reusable images and Python/Node-RED configurations, bringing legacy equipment into MQTT and OPC UA data streams.</li>
                  <li>Reduced per-unit deployment to roughly two hours through a documented three-step playbook, now the model for L2L machine integration across 31+ plants in North America.</li>
                </ul>
              </article>
            </div>
          </section>

          <section class="resume-section">
            <h2>Additional Technical Projects</h2>
            <div class="resume-projects">
              <article class="resume-project">
                <h3>Autonomous Rubik's Cube Solving Robot</h3>
                <p>Built an autonomous robot integrating Python, computer vision, Raspberry Pi/Linux, actuator control, CAD, and 3D-printed components; developed software to capture cube state, compute solutions, and coordinate motion end to end. Managed with Git and structured debugging, documented with a full build guide and bill of materials.</p>
              </article>
              <article class="resume-project">
                <h3>Full-Stack Wordle Game</h3>
                <p>Co-developed a browser-based word game in Python, JavaScript, HTML/CSS, SQL, and YAML using Scrum boards and GitHub, iterating on UI/UX from user feedback.</p>
              </article>
            </div>
          </section>

          <section class="resume-section resume-two-column">
            <div>
              <h2>Education</h2>
              <h3>B.S. Computer Science</h3>
              <p>Eastern Oregon University, 2024 | GPA approximately 3.6</p>
              <p>Coursework: Software Engineering, Application Security, Operating Systems, Data Structures, C/C++ Programming, Object-Oriented Programming, DBMS (SQL/MySQL)</p>
            </div>
            <div>
              <h2>Certifications</h2>
              <ul>
                <li>Ignition Core Certification, Inductive Automation, 2026</li>
                <li>Ignition University Credential, Inductive Automation, 2025</li>
                <li>Responsive Web Design, freeCodeCamp, 2024</li>
                <li>Git Essentials, LinkedIn Learning, 2024</li>
                <li>C# (Microsoft / freeCodeCamp), freeCodeCamp, 2024</li>
              </ul>
            </div>
          </section>

          <footer class="resume-footer">
            <a class="button button--secondary" href="/">Back to Portfolio</a>
            <a class="button button--primary" href="/resume.pdf" target="_blank" rel="noreferrer">Open PDF Version</a>
          </footer>
        </article>
      </div>
    </main>
    <footer class="site-footer">
      <BackToTop />
      <SiteCredit />
    </footer>
  </body>
</html>
