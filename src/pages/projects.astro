---
import SiteNav from "../components/SiteNav.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Selected SCADA, MES, IIoT, and industrial automation case studies by Bryant Hayden." />
    <title>Bryant Hayden — SCADA / MES Developer</title>
    <meta property="og:title" content="Bryant Hayden — SCADA / MES Developer" />
    <meta property="og:description" content="Industrial automation, SCADA, MES, and production systems portfolio." />
    <meta property="og:image" content="/og-preview.svg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-preview.svg" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="projects-page">
    <SiteNav active="portfolio" />

    <main>
      <section class="projects-hub-hero">
        <div class="container">
          <p class="eyebrow">Projects / Case studies</p>
          <h1>Software that earns its place on the plant floor.</h1>
          <p class="lead">Four production systems. Each opens as a ship story: problem, approach, architecture, implementation, results, and what I would do next.</p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <ProjectGrid />
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer__content">
        <p>© 2026 Bryant Hayden</p>
        <p>IT/OT • SCADA • MES • IIoT</p>
      </div>
    </footer>
  </body>
</html>
