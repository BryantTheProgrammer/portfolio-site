---
import SiteNav from "../components/SiteNav.astro";
import VirtualContactCard from "../components/VirtualContactCard.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Contact Bryant Hayden about SCADA, MES, industrial automation, and analytics opportunities." />
    <title>Bryant Hayden — SCADA / MES Developer</title>
    <meta property="og:title" content="Bryant Hayden — SCADA / MES Developer" />
    <meta property="og:description" content="Industrial automation, SCADA, MES, and production systems portfolio." />
    <meta property="og:image" content="/og-preview.svg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-preview.svg" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="contact-page">
    <SiteNav active="contact" />

    <main>
      <section class="contact-hero">
        <div class="container">
          <p class="eyebrow">Start a conversation</p>
          <h1>Let’s talk about production systems that need to work.</h1>
          <p class="lead">I’m open to conversations about SCADA, MES, IIoT, industrial automation, analytics, and the people who make those systems useful.</p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <VirtualContactCard />
        </div>
      </section>
    </main>

    <footer class="site-footer"><div class="container footer__content"><p>© 2026 Bryant Hayden</p><p>IT/OT • SCADA • MES • IIoT</p></div></footer>
  </body>
</html>
