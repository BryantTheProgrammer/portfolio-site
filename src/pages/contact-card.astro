---
import SiteNav from "../components/SiteNav.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Save Bryant Hayden's contact information and connect about controls engineering, SCADA, MES, and industrial automation."
    />
    <title>Bryant Hayden — Digital Contact Card</title>
    <meta property="og:title" content="Bryant Hayden — Digital Contact Card" />
    <meta property="og:description" content="Save Bryant Hayden's contact information and connect." />
    <meta property="og:image" content="/og-preview.svg" />
    <meta property="og:type" content="website" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="contact-card-page">
    <SiteNav active="contact" />

    <main class="contact-card-shell">
      <div class="container">
        <p class="eyebrow">Digital contact card</p>
        <h1 class="contact-card-title">Let’s connect.</h1>
        <p class="contact-card-intro">Save my details or reach out about controls engineering, SCADA, MES, and industrial automation.</p>

        <article class="virtual-card">
          <div class="virtual-card__identity">
            <div class="virtual-card__topline">
              <img class="virtual-card__portrait" src="/images/headshot3.png" alt="Bryant Hayden" />
              <span class="virtual-card__mark" aria-hidden="true">BH</span>
            </div>
            <div class="virtual-card__name-block">
              <p class="eyebrow">IT / OT · Industrial Automation</p>
              <h2>Bryant Hayden</h2>
              <p class="virtual-card__role">Controls Engineer</p>
              <p class="virtual-card__company">Lebanon, Oregon</p>
            </div>
            <div class="virtual-card__tags" aria-label="Areas of expertise">
              <span>SCADA</span>
              <span>MES</span>
              <span>IIoT</span>
              <span>Controls</span>
            </div>
          </div>

          <div class="virtual-card__details">
            <p class="eyebrow">Get in touch</p>
            <h3>Good systems start with a conversation.</h3>
            <div class="virtual-card__links">
              <a href="mailto:bryantchayden@gmail.com">
                <span class="virtual-card__label">Email</span>
                <span>bryantchayden@gmail.com</span>
              </a>
              <a href="tel:+19717166117">
                <span class="virtual-card__label">Phone</span>
                <span>(971) 716-6117</span>
              </a>
              <a href="https://www.linkedin.com/in/bhcs1/" target="_blank" rel="noreferrer">
                <span class="virtual-card__label">LinkedIn</span>
                <span>linkedin.com/in/bhcs1</span>
              </a>
            </div>
            <div class="virtual-card__actions">
              <a class="button button--primary" href="/bryant-hayden.vcf" download="Bryant-Hayden.vcf">Save Contact</a>
              <a class="button button--secondary" href="/resume">View Resume</a>
            </div>
          </div>
        </article>
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer__content">
        <p>© 2026 Bryant Hayden</p>
        <p>IT/OT · SCADA · MES · IIoT</p>
      </div>
    </footer>
  </body>
</html>
